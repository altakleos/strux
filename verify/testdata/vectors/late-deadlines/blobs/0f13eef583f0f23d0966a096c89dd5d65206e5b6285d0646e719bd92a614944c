# Definitions of the kernel package, the foundation's kernel, in definition format 1. Its
# rules and scenarios lie beside this file.
format: 1
package: kernel
revision: 1

types:
  validity:
    meaning: When an authority is in force, in times that anchors observe.
    fields:
      not_before: { type: time, meaning: "In force only at positions whose time, as anchors show it, is not earlier." }
      not_after: { type: time, meaning: "In force only at positions whose time, as anchors show it, is earlier." }
  workload-identity:
    meaning: The identity an identity provider issues to a running workload for the exact workload definition it runs, so that no signing secret is stored.
    fields:
      definition: { type: string, required: true, meaning: "The workload definition that runs, as the identity provider's token names it." }
      source: { type: string, required: true, meaning: "Where the workload definition is loaded from, as the token names it: a place nothing under verification can change." }
  credential:
    one_of:
      public_key: { type: string, meaning: "A public key, an `ed25519:` key." }
      workload_identity: { type: workload-identity, enabled: false, meaning: "A workload's identity, for the workload definition that runs. Whatever triggered the run is recorded but never trusted." }
      shared_account: { type: string, meaning: "An account on shared infrastructure. It signs no fact, and it is registered with the environment it can be used from." }
  witness:
    fields:
      principal: { type: principal, required: true, meaning: "The principal the witness is, as the trust root names it." }
      credential: { type: credential, required: true, meaning: "The credential its anchors are signed with." }
      environment: { type: string, required: true, meaning: "Where its credential can be used from, named as credential registrations name environments, so the evaluator's can be kept apart from it." }

parts:
  # The owner signs the record.
  signed-by-owner:
    conditions:
      signed-by-owner:
        rule: "Signed by the owner."
        expr: "fact.signer == trust_root.owner"
  # A trust-root act, which verification decides by the trust-root chain.
  trust-root-act:
    conditions:
      trust-root-act:
        rule: "It is a trust-root act."
        interpreter: verify.trust-root

definitions:
  trust-root:
    purpose: >
      Starts every verification: who the owner is, which keys sign trust-root acts and how
      many must sign together, the log's identity, whose anchors are recognized and where they are
      kept, and which facts make up the bootstrap. The initial trust root is configuration
      held outside the log; each later revision is a trust-root act in it.
    meaning:
      summary: "The trust root is the one thing a verifier takes on trust: who owns the log, and which keys can speak for the owner in a trust-root act."
      counterexamples:
        - { example: "A trust-root revision signed only by the owner's ordinary signing key.", why: "The revision is not recognized, since the owner's ordinary signing key is no key of the trust root." }
        - { example: "A revision whose threshold is zero, or larger than the number of keys it names.", why: "It could be signed by no one, or by everyone at once." }
    structure:
      owner: { type: principal, required: true, meaning: "The owner, who holds authority over every use." }
      keys: { type: list(string), required: true, meaning: "The trust-root public keys, each an `ed25519:` key." }
      threshold: { type: integer, required: true, meaning: "How many of the keys must sign a trust-root act together." }
      log: { type: digest, required: true, meaning: "The log's identity: 256 bits drawn at random afresh for each initial trust root, written as a digest and never reused. Every fact of the log names it in its signed envelope, and every anchor of the log names it." }
      witnesses: { type: list(witness), required: true, meaning: "The witnesses whose anchors are recognized, each outside every participant's reach but the owner's." }
      anchors_at: { type: text, required: true, meaning: "Where anchors are kept: where only their witness writes and nobody rewrites, never in the log they witness." }
      bootstrap: { type: list(digest), required: true, meaning: "The identities of the bootstrap facts, in order." }
      held_by: { type: text, required: true, meaning: "Where the configuration holding the initial trust root lives: a place nothing under verification can change, which changes only with the owner's approval." }
    uses:
      recognize:
        revises: true
        requires:
          trust-root-act:
            rule: "The revision is signed by fewer distinct keys of the trust root it supersedes than the threshold of that trust root names, or by fewer distinct keys of its own than its own threshold names, does not name the trust root it supersedes (the first revision names the initial trust root by the digest of its content), or another revision naming that trust root was recognized first."
            interpreter: verify.trust-root
          same-log:
            rule: "It names the same log as the trust root it follows."
            expr: "self.log == trust_root.log"
          same-bootstrap:
            rule: "It keeps the bootstrap list, since the log's first entries never change."
            expr: "self.bootstrap == trust_root.bootstrap"
          threshold-reachable:
            rule: "Its threshold is at least one, and no more than the keys it names."
            expr: "self.threshold >= 1 && self.threshold <= size(self.keys)"
          keys-distinct:
            rule: "It names each key once, so its threshold counts distinct keys."
            expr: "self.keys.distinct().size() == size(self.keys)"

  log:
    purpose: The signed facts, in the order the write path appended them.
    operations:
      bootstrap:
        at: write-path
        effect: "Creates the log with the bootstrap facts the initial trust root lists as its first entries, in that order; their signatures make them trust-root acts. The write path lets only the owner create the log."
        refuses: "Any log that already exists, and a caller that is not the owner the initial trust root names."
        returns: "The log's identity and the positions of the bootstrap facts; a refusal when a log exists or the caller is not the owner."
      append:
        at: write-path
        effect: "Accepts an append that leaves the earlier log as its prefix, and refuses a rewrite or a deletion. An append may add several entries, which take consecutive positions in the order it lists them. Every entry holds a fact, the content of that fact and the bytes the fact captures, so an append that leaves out any of them, or brings bytes whose SHA-256 differs from the digest that names them, is refused."
        returns: "The position of each entry appended, or a refusal naming the rule the append would break. Where the write path only appends, a fact that will not be recognized is appended anyway, so the positions say nothing about recognition."
      read:
        at: verification
        effect: "Reads entries in append order, and each append's entries in the order it lists them, and reports where the log stops extending a recognized anchor. An entry is invalid when the encoding refuses it: its bytes are not in the canonical form, its record or its signed object is malformed, it names another log than the trust root's, one of its signatures does not verify, or content bytes that match its content digest are not in the canonical form. No other entry is invalid, and none changes or removes an earlier fact: the signed object has no member that asks for it. Content or captured bytes that are not there where they are read, or that do not match their digests, leave the entry valid and count as absent. An append that was written and yet dropped or changed earlier entries is a rewrite and no invalid entry: it shows as a break, where a recognized anchor had witnessed what it dropped. A later copy of a fact has the same identity, the digest of what was signed apart from the signatures, so it is the same fact."
        returns: "The entries in append order, each valid or listed with what the encoding refuses of it, and whether the log is broken. Bytes it cannot read are a limit."

  verification:
    purpose: The deterministic computation, from declared inputs, of which facts are recognized and whether a use holds for a candidate.
    types:
      trust-root-configuration:
        meaning: What custody holds for the verifier, read where it is held and never supplied by the requester.
        fields:
          initial: { type: trust-root, required: true, meaning: "The initial trust root." }
          known: { type: digest, meaning: "The identity of the latest trust-root revision the configuration knows; absent when it knows only the initial trust root." }
          verifier: { type: digest, required: true, meaning: "The digest of the verifier's configuration." }
          source: { type: name, required: true, meaning: "Where the trust-root configuration and the verifier's configuration were read." }
          source_revision: { type: digest, required: true, meaning: "The revision of that source they were read from, which a result reports." }
      log-read:
        meaning: How much of the log was read.
        fields:
          log: { type: digest, required: true, meaning: "The identity of the log read; a log other than the one the initial trust root names is refused." }
          size: { type: integer, required: true, meaning: "How many entries were read, from position 0." }
          ended: { type: boolean, meaning: "True when a storage error ended the read before the log's head, which leaves the read behind." }
          read_at: { type: time, meaning: "When the verifier read the log. It is reported, and no condition reads it." }
      anchors-read:
        meaning: Where the anchors were read, and how many.
        fields:
          source: { type: name, required: true, meaning: "Where the anchors were read: where the trust root says they are kept. Where the trust root names no witness, it is where the verifier looked, and decides nothing, since no anchor is then recognized." }
          size: { type: integer, required: true, meaning: "How many anchors were read. More than the verifier can hold is a limit." }
      subject:
        meaning: The revision a reliance is about.
        one_of:
          recorded: { type: "ref(any)", meaning: "A revision that a fact recorded, named by that fact." }
          computed: { type: digest, meaning: "The content digest of an instance computed from its own inputs by the operation at verification that decides the use. That operation supplies the instance, and the result reports it in full." }
      reliance:
        meaning: The use relied on, for which subject, and where.
        fields:
          use: { type: string, required: true, meaning: "The use relied on, as package/definition.uses.name." }
          subject: { type: subject, required: true, meaning: "The revision the use is decided for." }
          position: { type: position, meaning: "Where the use is relied on: its state is read before this position. Absent, it is the number of entries read; a greater one is refused." }
      fact-conflict:
        meaning: The earlier recognized fact that holds what a later fact needed.
        fields:
          with: { type: position, required: true, meaning: "The position of the earlier recognized fact that took the predecessor, the instance or the operation identity, or that the later fact copies." }
          copy: { type: boolean, required: true, meaning: "True where the two have one identity, which is one fact appended twice, and false otherwise." }
      fact-not-recognized:
        meaning: A fact that is not recognized, with what failed.
        fields:
          position: { type: position, required: true, meaning: "Where the fact lies in the log." }
          failed: { type: list(string), required: true, meaning: "The conditions of recognize-fact that are unsatisfied and that no exception covers, each as an element path that starts with the name of its package, as `kernel/verification.uses.recognize-fact.requires.order` does, sorted as strings. Where its conditions condition is one of them, the unsatisfied and uncovered conditions of the fact's deciding use are listed with them, in the same form. Where its structure condition is one of them, neither the conditions condition nor any condition of the deciding use is listed. Where the log's first entries differ from the bootstrap list of the initial trust root, entry for entry, every fact lists the start condition `kernel/verification.uses.start.requires.bootstrap-first` alone. Where they match it and a bootstrap fact is not recognized, that fact lists what it fails, and every other fact lists that start condition alone." }
          unknown: { type: list(string), required: true, meaning: "The conditions that are unknown and that no exception covers, in the same form and order. A fact with none that failed is not recognized because an anchor closed the upper bound of its time while one of these had met no limit." }
          conflict: { type: fact-conflict, meaning: "The earlier fact it conflicts with, where its order condition failed against one." }
      fact-pending:
        meaning: A fact that is pending, because its time has an open upper bound and none of its unknown conditions met a limit.
        fields:
          position: { type: position, required: true, meaning: "Where the fact lies in the log." }
          unknown: { type: list(string), required: true, meaning: "The conditions that are unknown and that no exception covers, named and sorted as a fact that is not recognized names what failed." }
      limit-kind:
        meaning: "What a verifier lacked. read-behind: the read is behind. chain-act: a chain act it cannot decide ends the read. chain-short: the trust-root chain does not reach the revision its configuration knows. bootstrap: a bootstrap fact is indeterminate. absent-bytes: content or captured bytes are absent, or do not match their digest. interpretation: an interpretation revision or a kernel it does not implement. resources: it ran out of resources. indeterminate-fact: an evaluation read a fact that is itself indeterminate."
        enum: [read-behind, chain-act, chain-short, bootstrap, absent-bytes, interpretation, resources, indeterminate-fact]
      fact-indeterminate:
        meaning: A fact that a limit leaves undecided.
        fields:
          position: { type: position, required: true, meaning: "Where the fact lies in the log." }
          limits: { type: list(limit-kind), required: true, meaning: "The kinds of limit that stand in its way, each once, in the order their enumeration lists them." }
          unknown: { type: list(string), required: true, meaning: "The conditions that are unknown and that no exception covers, named and sorted as a fact that is not recognized names what failed; none for a fact after the position where the read ends, which no condition decides." }
      invalid-entry:
        meaning: An entry the encoding refuses.
        fields:
          position: { type: position, required: true, meaning: "Where the entry lies in the log." }
          refused: { type: "enum(record, log, signature, content)", required: true, meaning: "What the encoding refuses, the first of these that applies: the record, where its bytes, the record itself or its signed object is not what the encoding says it is; the log its fact names; a signature that does not verify for the key it names; or content bytes that match their digest and are not in the canonical form." }
      limit:
        meaning: One limit a run met.
        fields:
          kind: { type: limit-kind, required: true, meaning: "What the verifier lacked." }
          position: { type: position, meaning: "The entry the limit concerns, where it concerns one: the entry whose bytes or interpretation the verifier lacks, or the chain act that ends the read. Absent for a read that is behind, whose end the read's own result gives." }
      equivocation:
        meaning: Anchors of one witness that name the same previous anchor.
        fields:
          witness: { type: principal, required: true, meaning: "The witness whose anchors they are." }
          previous: { type: digest, meaning: "The identity of the anchor they name as previous; absent where they name none." }
          anchors: { type: list(digest), required: true, meaning: "The identities of the anchors, in ascending order of the position each witnesses and, at one position, of identity." }
      anchors-result:
        meaning: What a run made of the anchors it read.
        fields:
          recognized: { type: list(digest), required: true, meaning: "The identities of the anchors that are recognized, whether or not the log extends them, in ascending order of the position each witnesses and, at one position, of identity." }
          not_recognized: { type: list(digest), required: true, meaning: "The identities of the anchors read that are not recognized, those of an equivocation among them, in the same order." }
          not_extended: { type: list(digest), required: true, meaning: "The identities of the recognized anchors within the read that the log does not extend, in the same order. Each bounds no time, and the log has a break while there is one." }
          unreadable: { type: integer, required: true, meaning: "How many of the anchors read are not the anchor form of the encoding, and so have no identity." }
          equivocations: { type: list(equivocation), required: true, meaning: "Each equivocation that stands once the compromise revocations are applied, in ascending order of its witness and then of the position its first anchor witnesses. Every anchor of one is among those not recognized." }
      read-result:
        meaning: What a run found of the log against the recognized anchors.
        fields:
          behind: { type: boolean, required: true, meaning: "True when the read is behind." }
          ends_after: { type: position, meaning: "Set where the read ends before the last entry read: every fact after this position is indeterminate." }
          break_after: { type: position, meaning: "Set where the log has a break: the break starts after this position, so the next position is the first of the broken part." }
          disagreeing: { type: list(position), required: true, max: 9007199254740991, meaning: "The positions whose time the anchors bound with a lower bound later than the upper bound, in log order." }
      condition-result:
        meaning: The result of one condition of the use relied on, in each pass.
        fields:
          condition: { type: string, required: true, meaning: "The condition, as an element path that starts with the name of its package; the independent decision a use asks for is named by the path of the use's independent key." }
          first: { type: "enum(satisfied, unsatisfied, unknown)", required: true, meaning: "Its result over everything that is recognized before the position relied on, as the condition gives it: an exception that covers it leaves it as it is." }
          second: { type: "enum(satisfied, unsatisfied, unknown)", required: true, meaning: "Its result in the second pass, given in the same way. The pass is made whatever the first result is." }
          first_covered_by: { type: list(position), meaning: "The exceptions that cover it in the first pass, in log order: the earliest that covers it or, for a condition decided item by item, the earliest that covers each item that is not satisfied. Absent where it is satisfied in that pass or not covered there, as where an item that is not satisfied has no exception or whether one covers it is unknown." }
          second_covered_by: { type: list(position), meaning: "The exceptions that cover it in the second pass, given in the same way. An exception that the pass sets aside, or does not recognize, covers nothing there." }
      reliance-result:
        meaning: "Whether the use relied on holds for its subject, and what decided it. A run decides no use where the read is behind, where the position relied on lies after the start of a break, or where the trust-root chain does not reach the revision its configuration knows. In every other run the use is decided, also where a condition of it comes out unknown, and the result lists its conditions."
        fields:
          status: { type: "enum(holds, unsatisfied, pending, indeterminate)", required: true, meaning: "Whether the use holds, in the foundation's sense of the word, which counts a use that an exception permits. Where the run decides the use, it holds when the subject is recognized and every condition is, in each pass, satisfied or covered, and it is unsatisfied when the subject is not recognized or a condition is unsatisfied in a pass and not covered in it. Where neither is so, because the subject or a condition is left undecided, the reliance takes its status as the effect of verify gives a fact its own, by the time of the position before the one relied on: pending, indeterminate, or unsatisfied where a fact would be not recognized. Wherever the run decides no use, it is indeterminate where the read is behind or the trust-root chain does not reach the revision its configuration knows, and pending otherwise, as after the start of a break." }
          candidate: { type: string, meaning: "The candidate computed from the subject, whether or not the run decides the use; absent where it cannot be computed." }
          subject: { type: "enum(recognized, not-recognized, pending, indeterminate)", meaning: "The status, before the position relied on, of the fact that recorded the subject, whether or not the run decides the use; absent for a computed subject." }
          beneficiaries: { type: list(principal), meaning: "The use's beneficiaries, each once, sorted as strings; absent where the run decides no use, or a pending or indeterminate fact leaves them undecided." }
          conditions: { type: list(condition-result), required: true, key: condition, meaning: "Each condition the use requires, sorted by its path; none where the run decides no use. Whether a recorded subject is recognized is not listed here, since the subject's own status says it. Nor are the conditions of start, which every run meets before it decides a use, so a result gives none of them a value: it says what they found in what it gives of the read, in its limits, in the statuses of the bootstrap facts and in the inputs it reports." }
          set_aside: { type: list(position), required: true, max: 9007199254740991, meaning: "The facts before the position relied on that the second pass sets aside for the beneficiaries, in log order, whether or not a condition of the use reads them. A fact the pass keeps is not among them, whoever signed it. Nor is a fact that the first pass decides is not recognized, since setting it aside changes nothing: the list holds facts the first pass recognizes or leaves pending or indeterminate. There are none where the run decides no use." }
          second_only: { type: list(position), required: true, max: 9007199254740991, meaning: "The facts recognized in the second pass and not in the first, in log order; none where the run decides no use." }
          first_only: { type: list(position), required: true, max: 9007199254740991, meaning: "The facts before the position relied on that are recognized in the first pass and not in the second, other than those the pass sets aside, in log order; none where the run decides no use." }
          exceptions: { type: list(position), required: true, max: 9007199254740991, meaning: "Where the use holds, every exception that one of its conditions names as covering it in a pass and, for each read of a use through permitted that comes out true, every exception that one of that use's conditions names in the same way, in log order, each once; none where the use does not hold. An exception listed for a first pass alone can be a beneficiary's, which the second pass sets aside." }
          limits: { type: list(limit-kind), required: true, meaning: "The kinds of limit that leave it indeterminate, each once, in the order their enumeration lists them." }
    meaning:
      summary: "Verification answers whether a fact is recognized and whether a use holds, and changes nothing in the log. Its `start` and `recognize-fact` uses benefit no particular party: they decide what is recognized for everyone who relies on the log, and every condition of them is decided by verification itself, so each names an empty list of beneficiaries."
      counterexamples:
        - { example: "Treating a fact's presence in the log as proof that it is recognized.", why: "Presence decides nothing: a fact is recognized only when verification finds it valid at its position." }
    operations:
      verify:
        at: verification
        inputs:
          trust_root_configuration: { type: trust-root-configuration, required: true, meaning: "The initial trust root, the latest revision known and the verifier's configuration, which the verifier reads where custody holds them. For a candidate, that is the revision of that place which the candidate would change on taking effect, and never the candidate's own copy. The requester never supplies them, and the result reports where and at which revision the verifier read them." }
          log: { type: log-read, required: true, meaning: "The log, read in append order from position 0 after the anchors, from a store at least as current as the one the witnesses anchor, and no entry past what was read." }
          anchors: { type: anchors-read, required: true, meaning: "The anchors read from where the trust root keeps them, each in the encoding's anchor form, as a set by identity. They are read before the log, and include the anchor that the verifier, as a witness, then makes or finds already made of the head it read; no other anchor written after the log was read is among them." }
          reliance: { type: reliance, meaning: "The use relied on, with its subject and position; absent for a run that only reports what is recognized." }
        effect: "Reads the declared inputs, decides which facts are recognized and, for a reliance, whether its use holds, and reports the result with the inputs it read. Where a recognized anchor lies at a position the read did not reach, or a storage error cut the read short, the read is behind: no use is decided, each fact past a point where the unread entries could start a break is indeterminate, and each fact before it is decided as on any read. After the start of a break no use is decided either, and the use relied on is pending unless the read is also behind or the trust-root chain falls short. For a recorded subject, whether its fact is recognized is decided with the use's conditions; for a computed one, the operation that decides the use supplies the instance, and no fact recorded it. A condition reads state as of the position where it is decided: facts recognized before it, and only the bytes those facts, or the fact being decided, carry. Of a fact pending or indeterminate there it reads the fact, its content and its digest, as a possible member of a list, and never the bytes it captures. Each fact gets one of four statuses. It is recognized when every condition holds or is covered, and not recognized when one fails uncovered. Where only unknown conditions remain, it is indeterminate if one of them met a limit, unless an anchor closes the upper bound of its time and another met none, which leaves it not recognized; if none met a limit, it is pending until an anchor closes that bound and not recognized after. A reliance is classified in the same way by the time of the position before it. A read that reaches a use while that use is being decided, for the same revision at the same position and in a pass that keeps and sets aside the same facts, is unknown, so a cycle among uses is unknown, and nothing is inferred from what is pending or indeterminate. It appends nothing and makes no anchor."
        refuses: "A log other than the one the initial trust root names; and a reliance whose recorded subject is no valid entry read before its position, whose subject's kind does not declare the use, or whose position lies past the entries read."
        outputs:
          recognized: { type: list(position), required: true, max: 9007199254740991, meaning: "The positions of the facts that are recognized, in log order." }
          not_recognized: { type: list(fact-not-recognized), required: true, max: 9007199254740991, key: position, meaning: "The facts that are not recognized, in log order." }
          pending: { type: list(fact-pending), required: true, max: 9007199254740991, key: position, meaning: "The facts that are pending, in log order." }
          indeterminate: { type: list(fact-indeterminate), required: true, max: 9007199254740991, key: position, meaning: "The facts that are indeterminate, in log order." }
          invalid: { type: list(invalid-entry), required: true, max: 9007199254740991, key: position, meaning: "The invalid entries, in log order. Every entry read is in exactly one of these five lists, with the status it has over everything that is recognized; what the second pass of a reliance decides otherwise is in the reliance's result." }
          anchors: { type: anchors-result, required: true, meaning: "The anchors read, as recognized or not, and each equivocation." }
          read: { type: read-result, required: true, meaning: "Whether the read is behind, where it ends, any break, and any position whose time the anchors bound inconsistently." }
          reliance: { type: reliance-result, meaning: "Whether the use relied on holds; absent for a run without a reliance." }
          limits: { type: list(limit), required: true, meaning: "Every limit the run met, in the order their kinds are enumerated and then by position." }
        returns:
          - "each recorded reliance whose result a compromise revocation changes"
          - "each bootstrap package revision that has a semantic check which no recognized finding answers"
          - "its declared inputs: the trust-root configuration, the verifier's configuration and the revision they were read from; the log head it read and when it read it; the anchors read and when; the reliance, meaning the use, its subject, the candidate computed from that subject, the position relied on and what the verifier itself observed for it; the custody profile, configuration and package revisions in force at that position; and its own version"
          - "for each evaluation request a result read, who signed it and its coverage: the checks it asks for that no recognized finding answers"
          - "every assertion's assurance class, computed relative to the participant concerned: a signer is attested to that participant only when no environment in the participant's reach can use its credential, taking the environments of the credentials whose registration to that participant is in force, accounts on shared infrastructure among them; a class its signer wrote is treated as declared, and a finding takes the class of the content it judges beside that of its evaluator, which is enforced when the evaluator lies outside the participant's reach and declared when it lies within"
          - "the decision points of the custody profile that lie within an agent's reach or have no component placed, which make the rules decided there guardrails"
    uses:
      start:
        beneficiaries: "[]"
        requires:
          trust-root-chain:
            rule: "The log's trust-root revisions form a chain from the configured initial trust root, each recognized under the trust root before it and naming it, and the chain reaches the latest revision the configuration knows; otherwise the limit is reported and every use is unknown. A chain act that is indeterminate cuts the read short: where it lies, or, for a compromise revocation, at the position it names, or just after the bootstrap when that position cannot be read."
            interpreter: verify.trust-root
          bootstrap-first:
            rule: "The first entries of the log are not exactly the bootstrap facts that the initial trust root lists, in the order it lists them, or one of those facts is not recognized at its own position, where the earlier ones count as recognized and the later ones do not, apart from the bootstrap's own packages, custody profile and configuration, which count as in force. While one of them is indeterminate, everything else that would be recognized is indeterminate as well; while one is pending and none is indeterminate, everything else waits as pending."
            interpreter: verify.bootstrap
          anchors:
            rule: "The relied-on position lies after the start of a break, or the read is behind: a recognized anchor lies at a position the read does not reach, or a storage error cut the read short."
            interpreter: verify.anchors
      recognize-fact:
        beneficiaries: "[]"
        requires:
          package-active:
            rule: "The package revision it names is activated by the configuration in force at its position. A trust-root revision or a compromise revocation is judged by the kernel revision it names instead, which has to be the kernel of an interpretation the verifier implements, as the record or, before the record pins it, the bootstrap configuration fixes it, through the revision of the record's kernel package that it pins; a kernel it cannot identify leaves the act indeterminate, as a limit."
            interpreter: verify.package
          signature:
            rule: "Its signers may not sign it at its position. A trust-root act names no key, and needs signatures from distinct keys of the trust root in force, as many as the threshold of that trust root names, and a trust-root revision also needs distinct keys of its own, in the number that its own threshold names. Any other fact signed by a key names that key, which needs to be a credential whose registration is in force there, that may sign this kind and that is no key of the trust root in force. A trust-root act is a trust-root revision, a compromise revocation, a bootstrap fact, or a registration of a credential of the owner; outside the bootstrap, a registration of another principal's credential is none. A workload identity needs a token for its registered definition and source."
            interpreter: verify.signature
          not-compromised:
            rule: "A compromise revocation covers its credential at its position, from the position it states. It never covers a trust-root act."
            interpreter: verify.compromise
          not-in-broken-part:
            rule: "Its position lies after the start of a break, and the fact is not a trust-root act. The start follows the breaking witness's last recognized anchor that the log extends, or the bootstrap if the log extends none of them, and the earliest of these when anchors of several witnesses break. The fact's other conditions are decided as anywhere, and of what lies after the start they read only trust-root acts as recognized."
            interpreter: verify.anchors
          in-time:
            rule: "Its position's time, as anchors bound it, does not lie before its append deadline or within the validity of the authority it relies on, or it is a fact of a governing definition, other than a bootstrap fact, that carries no deadline; it is pending while a bound that no anchor has closed could still decide this. A deadline or a validity's end is tested against the upper bound alone, and a validity's start against the lower bound alone, so anchors that disagree never leave the test unknown. A position that has no lower bound fails the test of a start. An anchor that the log extends bounds time on either side of the start of a break."
            interpreter: verify.time
          authority:
            rule: "A trust-root act, a fact the owner signed, or a revocation signed by whoever signed what it ends needs no grant. Any other fact lacks the grant its `under` names, held by its signer and in force at its position, that covers the use deciding it, for an exception the use named in the exception with `.except` after it, or the uses it covers for a grant; or a condition of that grant, or of a grant it was issued under, fails for the fact. A grant is in force at a position when its record was recognized earlier, no later revision or recognized revocation has replaced it before the position, the position's time falls inside its validity if it has one, and the authority that issued it is itself in force there. A revocation or a revision takes effect from its own position and changes nothing earlier."
            interpreter: verify.authority
          supply-chain:
            rule: "A component the custody profile names signed it without recording the digests of the configurations it ran, or recorded one that the custody profile in force does not pin."
            interpreter: verify.supply-chain
          deciding-use:
            rule: "Its operation, of its own kind, names no use, or another kind's operation appended it and its kind has no `recognize` use, or it names an expected predecessor and its deciding use does not declare `revises`."
            interpreter: verify.conditions
          conditions:
            rule: "It is not decided for content that fails its structure. It is unsatisfied when a condition of its deciding use is unsatisfied at its position, over everything that is recognized or in the second pass made for the use's beneficiaries, and no exception covers it, and unknown when one is unknown in either pass and uncovered. An exception covers a condition only when the condition is one that the use marks waivable and that no capability of the interpreter decides, when the exception was recognized before the position of the decision and is in force there, each in the pass where it is to cover, and when it names the use, the candidate and the condition, and also the item if the condition is judged one item at a time; the condition stays unsatisfied or unknown, and the exception lets the use go on despite it. A condition that depends on a pending or indeterminate input is unknown. The second pass decides each fact before the position where the use reads state once more, apart from what it keeps, and leaves out each fact that a beneficiary other than the owner could have signed, at that fact's own position, taking the beneficiaries and what they could have signed from the pass in which the use is read. It keeps, with their status in that pass, the trust-root acts, the decided revision together with its fact and its predecessor, and the findings signed from outside every beneficiary's reach. The owner's facts signed from outside the reach of every other beneficiary, and facts of the kinds the use accepts as declared, are decided once more and never left out. A fact decided once more also fails where its content names, by exact reference, an earlier fact that the pass reading the use recognizes and the second pass does not, and it waits as pending or indeterminate while that fact does. A digest in its content that is no part of a reference decides nothing of this. While a pending or indeterminate fact leaves the use's beneficiaries, the kinds it accepts as declared or requires as independent, or what is left out undecided, each condition's second pass is unknown. A semantic check is decided by the recognized findings made for the revision decided, combined as the check declares, with the check's cap shared by the findings on all revisions of an instance, in log order. A finding from outside every beneficiary's reach is recognized in both passes, whoever signed its request, and its request resolves through that finding for every reader, though the second pass sets the request itself aside or no longer recognizes it. Reach is read from the registrations of the credentials, never from where the custody profile places evaluation."
            interpreter: verify.conditions
          structure:
            rule: "Its content does not conform, as the definition format defines conforming, to its kind's structure as declared by the package revision that the fact names. Where package-active does not hold, this is not decided and not listed. Its deciding use is not decided on content that fails, so the conditions condition and the conditions of that use are not listed; every other condition is decided as for any fact, and one that reads the content reads it as it is."
            interpreter: verify.conditions
          order:
            rule: "Its predecessor, its instance or its operation identity is not available to it: the predecessor, other than that of a trust-root revision, which the trust-root chain decides, is not a fact of the fact's own kind recognized before it, or is already taken, it starts a second instance of a singleton definition, it carries an operation identity that an earlier recognized fact of the same signer and operation carries too, or it is a copy. A copy is a fact whose signed object has the same digest as that of an earlier recognized fact, so that the two have one identity, and only the first copy that is recognized takes a position. A compromise revocation is tested against the chain acts before it alone, and only as a copy or for its operation identity."
            interpreter: verify.order

  custody-profile:
    purpose: Records who holds what the guarantees rest on, and which component sits at each decision point.
    governing: true
    singleton: true
    types:
      elements:
        meaning: The foundation's custody elements, as this installation holds them.
        fields:
          trust_root: { type: text, required: true, meaning: "Where the trust root every verifier starts from is configured, and who may approve a change to that configuration." }
          log: { type: text, required: true, meaning: "Which component holds the write path to the log, and how it keeps append order." }
          credentials: { type: text, required: true, meaning: "Which credentials exist, which principal each belongs to, and the environment each can be used from." }
          identities: { type: text, required: true, meaning: "Where principals' identities come from and how callers are authenticated." }
          access: { type: text, required: true, meaning: "Each participant's identities and permissions on shared infrastructure, which references it can write and which content it may read through Strux's interfaces." }
          verification: { type: text, required: true, meaning: "Which component runs verification at reliance for each use, from which configuration, and who controls that configuration." }
          evaluators: { type: text, required: true, meaning: "Who runs the evaluations that gate uses, and under which credential their findings are signed." }
          supply_chain: { type: text, required: true, meaning: "The configurations each trusted component may run, pinned by digest, and what trusted components may consume from untrusted ones." }
          isolation: { type: text, required: true, meaning: "What each participant can read and change outside Strux's operations." }
      decision-point:
        fields:
          component: { type: text, required: true, meaning: "The component that holds the decision point, as the installation names it." }
          reach: { type: "enum(outside, agent)", required: true, meaning: "Whether the component lies outside every agent's reach, in the foundation's meaning of outside." }
      configuration-digests:
        meaning: The digests of the configurations each trusted component may run. During a change, a profile may pin both the old and the new.
        fields:
          verifier: { type: list(digest), required: true, meaning: "The digests of the configurations the verifier may run." }
          evaluator: { type: list(digest), required: true, meaning: "The digests of the configurations the evaluator may run." }
          workloads: { type: list(digest), required: true, meaning: "The digests of the workload definitions the installation runs, pinned as the verifier's and the evaluator's configurations are." }
    meaning:
      summary: "The custody profile says who holds the means every guarantee rests on, and which component sits at each decision point, so a result can say whether a rule is a guarantee or only a guardrail."
      counterexamples:
        - { example: "A profile that names the verifier as the evaluator too.", why: "The profile is not recognized." }
        - { example: "A change to the profile signed by someone other than the owner.", why: "The profile in force stays as it was." }
    structure:
      elements: { type: elements, required: true }
      decision_points: { type: "map(string, decision-point)", required: true, meaning: "The component at each decision point: those the definition format defines, and those the activated packages declare, written package/name." }
      verifier: { type: principal, required: true, meaning: "The principal that runs verification at reliance, whatever component the installation chooses for it." }
      evaluator: { type: principal, required: true, meaning: "The principal that runs the evaluations that gate uses, and signs their findings." }
      configuration: { type: configuration-digests, required: true, meaning: "The configurations it puts in force, by digest." }
    uses:
      recognize:
        revises: true
        includes: [signed-by-owner]
        requires:
          evaluator-apart:
            rule: "Its evaluator is neither its verifier nor a witness the trust root names."
            expr: "self.evaluator != self.verifier && !trust_root.witnesses.exists(w, w.principal == self.evaluator)"
          evaluator-credentials-apart:
            rule: "The credentials already registered to its evaluator sign only findings and share no environment with a witness's or with its verifier's, so naming the evaluator does not give it a credential it must not hold."
            expr: >-
              history(kernel.credential_registration).filter(r, in_force(r) && r.content().principal == self.evaluator)
                .all(r, r.content().may_sign.all(k, k == 'kernel/finding')
                  && !trust_root.witnesses.exists(w, w.environment == r.content().environment)
                  && history(kernel.credential_registration).filter(v, in_force(v) && v.content().principal == self.verifier)
                    .all(v, v.content().environment != r.content().environment))

  credential-registration:
    purpose: Registers a credential so that facts it signs can be attributed to a principal.
    governing: true
    meaning:
      summary: "A registration attributes the facts a credential signs to a principal and says where the credential can be used from. The environment is what makes a participant's reach known."
      counterexamples:
        - { example: "A registration of an agent's key without the environment its machine provides.", why: "The environment is required: without it the agent's reach, and so what it may discharge, is unknown." }
        - { example: "A registration of a trust-root key as an ordinary credential.", why: "A trust-root key signs nothing but trust-root acts." }
    structure:
      principal: { type: principal, required: true, meaning: "The principal the credential's facts are attributed to." }
      credential: { type: credential, required: true, meaning: "The credential being registered." }
      environment: { type: string, required: true, meaning: "The identifier the custody profile assigns to where the credential can be used from: a machine and operating-system account, a device such as the owner's hardware, or a workload's runtime. Credentials registered with the same environment share reach, and a principal's reach is the set of its credentials' environments." }
      may_sign: { type: list(string), required: true, meaning: "The kinds of fact it may sign, as package/definition; none for a shared account." }
      validity: { type: validity }
    uses:
      recognize:
        revises: true
        includes: [signed-by-owner]
        let:
          registered: "history(kernel.credential_registration).filter(r, in_force(r))"
        requires:
          not-a-trust-root-key:
            rule: "Its credential is no key of the trust root in force, so trust-root keys sign nothing but trust-root acts."
            expr: "!has(self.credential.public_key) || !(self.credential.public_key in trust_root.keys)"
          evaluator-signs-findings:
            rule: "A credential of the evaluator the custody profile names may sign findings and nothing else."
            expr: "self.principal != custody.evaluator || self.may_sign.all(k, k == 'kernel/finding')"
          apart-from-evaluator:
            rule: "A credential of the evaluator is usable from no environment of the verifier's credentials or a witness's, and one of the verifier from no environment of the evaluator's, so a misled evaluation can use no credential but its own."
            expr: >-
              (self.principal != custody.evaluator
                || (!trust_root.witnesses.exists(w, w.environment == self.environment)
                  && registered.all(r, r.content().principal != custody.verifier || r.content().environment != self.environment)))
              && (self.principal != custody.verifier
                || registered.all(r, r.content().principal != custody.evaluator || r.content().environment != self.environment))

  grant:
    purpose: Gives a principal authority over named uses, limited by conditions every fact under it must satisfy.
    governing: true
    structure:
      principal: { type: principal, required: true, meaning: "The principal the grant gives authority to." }
      covers: { type: list(string), required: true, meaning: "Uses, as package/definition.uses.name; a use followed by .except covers exceptions to it." }
      conditions: { type: list(condition), required: true, meaning: "What every fact under it must satisfy at its position, as expressions in the context of the use that decides that fact. They limit it to a scope, a kind of change, or a component's standing duty." }
      validity: { type: validity }
      delegable: { type: boolean, required: true, meaning: "Whether its principal may issue grants for what it covers onward." }
      issued_by: { type: principal, required: true, meaning: "The principal that issued the grant: the owner, or a principal whose grant is delegable." }
    meaning:
      summary: >
        A component's standing duty, such as the verifier requesting every evaluation whose
        conditions hold, is a grant to that component whose conditions state when.
      counterexamples:
        - { example: "A grant that covers a use which the grant it was issued under does not cover.", why: "The grant is not recognized, since its signer holds no delegable grant that covers that use." }
    uses:
      recognize:
        revises: true
        requires:
          issued-by-signer:
            rule: "Signed by the principal it names as issuing it."
            expr: "fact.signer == self.issued_by"
          revised-by-issuer:
            rule: "A revision is signed by whoever signed the grant it supersedes, or by the owner."
            expr: "!has(fact.expected) || fact.signer == predecessor.fact().signer || fact.signer == trust_root.owner"
          within-issuer:
            rule: "Issued by the owner, or under a delegable grant held by the signer that covers every use it covers."
            expr: >-
              fact.signer == trust_root.owner
              || (has(fact.under)
                && fact.under.content().principal == fact.signer
                && fact.under.content().delegable
                && self.covers.all(u, u in fact.under.content().covers))

  revocation:
    purpose: Ends a decision, such as a grant, a credential registration, an exception or another decision.
    meaning:
      summary: "A revocation names the decision it ends and may say why."
      counterexamples:
        - { example: "A revocation of a trust-root revision.", why: "Only a later trust-root act supersedes a trust-root revision." }
    structure:
      revokes: { type: ref(any), required: true, meaning: "The decision it ends." }
      reason: { type: text, meaning: "Why the decision is ended." }
    uses:
      recognize:
        requires:
          revokes-no-trust-root-decision:
            rule: "It revokes no trust-root revision or compromise revocation."
            expr: "!(self.revokes.fact().kind in ['kernel/trust-root', 'kernel/compromise-revocation'])"
          signed-by-issuer:
            rule: "Signed by whoever signed what it revokes, or by the owner."
            expr: "fact.signer == self.revokes.fact().signer || fact.signer == trust_root.owner"

  compromise-revocation:
    purpose: >
      Declares a credential compromised from a stated position. A trust-root key is retired by a
      trust-root revision instead, which this does not replace.
    meaning:
      summary: "A compromise revocation declares a credential compromised, with the reason, from a stated position. It is a trust-root act."
      counterexamples:
        - { example: "Retiring a trust-root key by a compromise revocation.", why: "A trust-root revision retires a trust-root key." }
    structure:
      credential: { type: string, required: true, meaning: "The compromised credential, spelled as its registration or the trust root spells it: an `ed25519:` key, a witness's among them, or a workload identity's definition." }
      from: { type: position, required: true, meaning: "The position from which the credential is treated as compromised." }
      reason: { type: text, required: true, meaning: "What shows or suggests the compromise." }
    uses:
      recognize:
        includes: [trust-root-act]

  exception:
    purpose: Records that one named use is permitted for one named candidate despite one named condition, with the basis and the reason.
    governing: true
    structure:
      use: { type: string, required: true, meaning: "The use it permits, as package/definition.uses.name." }
      candidate: { type: string, required: true, meaning: "The candidate it permits the use for, exactly as the use's candidate gives it." }
      condition: { type: string, required: true, meaning: "The condition it permits the use despite, by its name in the use." }
      item: { type: string, meaning: "For a condition decided item by item, the address of the one item it covers." }
      basis: { type: list(ref(any)), meaning: "What it rests on, such as findings on another revision." }
      reason: { type: text, required: true, meaning: "Why the exception is given." }
      validity: { type: validity }
    meaning:
      summary: "An exception names the use, the candidate and the condition it permits the use despite. It is recognized on verification's own steps alone: authority over exceptions to its use, and its append deadline."
      counterexamples:
        - { example: "An exception for a condition its use does not declare waivable.", why: "The exception permits nothing." }
    uses:
      recognize: {}

  evaluation-request:
    purpose: >
      Asks for one evaluation: which checks of which exact revision, for which intended use, with
      which context, each with its treatment. Its signer chose the evaluator's inputs, which a result shows,
      and the checks it asks for that no finding answers are what the evaluation omitted.
    types:
      context-reference:
        fields:
          reference: { type: ref(any), required: true }
          treatment: { type: "enum(governing, examined, supporting)", required: true, meaning: "Governing inputs, such as policies, may direct the evaluator; examined content and supporting references are data." }
    structure:
      candidate: { type: ref(any), required: true, meaning: "The exact revision to evaluate, which the evaluator examines." }
      part: { type: string, meaning: "The addressable part of the candidate to evaluate, by its local identifier, when the request concerns one." }
      checks: { type: list(string), required: true, meaning: "The checks to run, as element paths qualified by package, each a path under the checks of the candidate's definition." }
      intended_use: { type: string, meaning: "The use the evaluation is requested for, as package/definition.uses.name: context the evaluator may take, which no finding is bound to." }
      context: { type: list(context-reference), required: true, meaning: "Every other input the evaluator receives, each with its treatment; the policies that govern the checks are among them, as governing." }
    meaning:
      summary: >
        The request names no definition or interpretation revision: the candidate's fact names
        the package revision that decides it, and the configuration in force at the request's
        position names the interpretation. An evaluator receives exactly the candidate and this
        context, governing inputs through a channel of their own, and never resolves an input
        from references inside the content it judges.
      counterexamples:
        - { example: "A request that asks for a check of another definition.", why: "Each check must lie under the checks of the candidate's definition, so the request is about something the candidate can be judged on." }
    operations:
      request:
        at: client
        use: recognize
        effect: "Appends the request, for the evaluator the custody profile names to answer."
        returns: "A receipt with the request's identity and position, or a refusal naming the failed condition. A request is recognized only when a verifier finds it valid where it is relied on."
    uses:
      recognize:
        requires:
          checks-of-candidate:
            rule: "It asks for no check, or for a check that is not a path under the checks of the candidate's definition."
            expr: "size(self.checks) > 0 && self.checks.all(c, c.startsWith(self.candidate.fact().kind + '.checks.'))"
          governing-context-owned:
            rule: "An input named as governing was not recorded by the owner, and neither the owner nor the verifier signed the request, so the request's signer cannot make content of its own direct the evaluator."
            expr: "fact.signer == trust_root.owner || fact.signer == custody.verifier || self.context.all(c, c.treatment != 'governing' || c.reference.fact().signer == trust_root.owner)"

  finding:
    purpose: Records one evaluator's result for one check of exact revisions, answering one evaluation request.
    meaning:
      summary: "A finding is one evaluator's result for one check, bound to the revisions it judged and to the request it answers."
      counterexamples:
        - { example: "A participant's written note recorded as a finding.", why: "A finding is signed by the evaluator the custody profile names; a statement is ordinary instance content." }
        - { example: "A finding for a check its request did not ask for.", why: "It answers no request, so it is not recognized." }
    structure:
      check: { type: string, required: true, meaning: "The check, an element path qualified by package." }
      result: { type: "enum(satisfied, unsatisfied, unknown)", required: true, meaning: "Whether the check holds, does not hold, or is not established by the evidence available." }
      bound_to: { type: list(digest), required: true, meaning: "The digests of the revisions it is bound to: its request's candidate, which it judges, and any of the request's context it relied on." }
      request: { type: ref(evaluation-request), required: true, meaning: "The request it answers, whose candidate and context were the evaluator's inputs." }
      evidence: { type: text, meaning: "What supports the result, such as the passages or facts relied on." }
      reasoning: { type: text, meaning: "How the evidence leads to the result, within the context supplied." }
    operations:
      evaluate:
        at: evaluation
        use: recognize
        effect: "Runs the checks a recognized request asks for, on its candidate and with exactly its context, and appends one finding for each: unknown where the check could not be decided."
        reports: "The request's coverage: each check it asks for that no recognized finding answers, as omitted."
        returns: "A receipt for each finding appended, and the request's coverage with each check no recognized finding answers as omitted. A check the evaluator could not decide gets an unknown finding, never silence."
    uses:
      recognize:
        let:
          request: "self.request.content()"
        requires:
          signed-by-evaluator:
            rule: "Signed by the evaluator the custody profile names."
            expr: "fact.signer == custody.evaluator"
          answers-request:
            rule: "The finding names a check its request did not ask for, is not bound to the candidate its request names, or is bound to a revision outside that request's candidate and context."
            expr: >-
              self.check in request.checks
              && request.candidate.digest() in self.bound_to
              && self.bound_to.all(d, d == request.candidate.digest() || request.context.exists(x, x.reference.digest() == d))

  package-revision:
    purpose: >
      Records one revision of a package, the definitions content is governed by, as content like
      any other, so that definitions are examined, corrected and activated through the same public
      paths as what they govern. It is the definition of a definition: a revision's shape is the
      definition format, which only the interpreter can check, and its semantic check judges whether each
      definition explains what it governs.
    structure:
      name: { type: string, required: true, meaning: "The package's name, as its definitions file states it." }
      revision: { type: integer, required: true, meaning: "The package revision its definitions file states." }
      digest: { type: digest, required: true, meaning: "The digest of the canonical form of its definitions file's content: the package revision's identity, by which a fact names the package revision that decides it." }
      bytes: { type: digest, required: true, meaning: "The SHA-256 digest of the definitions file's bytes, which the fact's entry carries." }
    meaning:
      summary: >
        The format is fixed by the interpretation revision, not by this definition, so no package
        revision can redefine what a definition is, and one that uses features its stated
        format does not define is not well-formed. Whether a well-formed revision
        conforms together with the packages it depends on is decided when a configuration pins
        them, since their revisions are the configuration's choice. Its semantic check gates no
        use: its findings inform whoever activates the revision. A revision may be recorded in any
        format some interpretation revision defines, so a package can be revised into a new format
        before the configuration that activates it moves to that interpretation revision.
      counterexamples:
        - { example: "A package revision whose definitions declare themselves approved.", why: "The revision is recorded and stays inactive." }
    checks:
      semantic:
        purposes-explain:
          expectation: Each definition's purpose explains the concept it governs, what it is for and its limits, rather than restating its name, and each field's meaning says what the field holds.
          evaluator: the evaluator the custody profile names, given the package revision and the revisions of the packages it depends on
    operations:
      record:
        at: client
        use: recognize
        effect: "Appends the package revision, its entry carrying the definitions file's bytes."
        refuses: "Bytes that are not a well-formed definitions file, and a revision that does not follow the one it supersedes."
        returns: "A receipt with the package revision's identity and position, or a refusal for bytes that are not a well-formed definitions file."
    uses:
      recognize:
        revises: true
        requires:
          well-formed:
            rule: "Its entry carries bytes with the digest it records, which are a well-formed definitions file, in which a use that decides no fact names its beneficiaries and a semantic check that a condition names declares its combination, whose canonical form has the digest it records and that states the name and revision it records."
            interpreter: verify.definitions
          follows-predecessor:
            rule: "A revision is of the same package as the revision it supersedes, with a higher revision number, and is signed by whoever signed that revision or by the owner."
            expr: >-
              !has(fact.expected)
              || (self.name == predecessor.content().name
                && self.revision > predecessor.content().revision
                && (fact.signer == predecessor.fact().signer || fact.signer == trust_root.owner))

  configuration:
    purpose: Pins, for its log, the package revisions in force and the interpretation revision that gives them their meaning. Activating a package revision is a change of configuration.
    governing: true
    singleton: true
    meaning:
      summary: "The configuration pins the package revisions in force and the interpretation revision that gives them meaning. Activating a package revision is a change of configuration."
      counterexamples:
        - { example: "A configuration that pins two revisions of one package.", why: "It pins one revision of each package." }
        - { example: "A configuration whose kernel is not the one its interpretation revision names.", why: "The configuration is not recognized." }
    structure:
      packages: { type: list(ref(package-revision)), required: true, meaning: "The package revisions in force, by exact reference." }
      interpretation: { type: integer, required: true, meaning: "The interpretation revision that gives them their meaning, whose record names the kernel package among them and, once a version is released, pins its revision." }
    uses:
      recognize:
        revises: true
        requires:
          one-revision-each:
            rule: "It pins one revision of each package."
            expr: "self.packages.map(p, p.content().name).distinct().size() == self.packages.size()"
          packages-conform:
            rule: "A package revision it pins was not recognized before it, where the bootstrap configuration counts the bootstrap's package revisions as recognized wherever they sit, the pinned revisions do not conform together to the format of its interpretation revision, or the kernel among them is not the one that interpretation revision names, by digest: the revision of the record's kernel package that the record pins or, while it pins none, that the bootstrap configuration pins."
            interpreter: verify.package

  anchor:
    purpose: Witnesses the log's head at a position, with the time the witness observed.
    meaning:
      summary: "An anchor is a witness's signed statement of the log's head at a position and a time. It gives the log a clock and makes a rewrite detectable."
      counterexamples:
        - { example: "An anchor kept in the log it witnesses.", why: "The anchor is not recognized, since it was not read from where anchors are kept." }
        - { example: "An anchor that names no earlier anchor of its witness, after the first.", why: "The anchor is not recognized, since it follows no recognized anchor of its witness." }
    structure:
      log: { type: digest, required: true, meaning: "The identity of the log it witnesses." }
      key: { type: string, required: true, meaning: "The key that signs it, a witness's credential." }
      position: { type: position, required: true, meaning: "The position of the log's head when it was observed." }
      head: { type: digest, required: true, meaning: "The log's head at that position, which the encoding computes over the records up to it, invalid ones included." }
      observed: { type: time, required: true, meaning: "The time at which the witness observed the head." }
      previous: { type: digest, meaning: "The identity of its witness's last recognized anchor; absent for its witness's first." }
    uses:
      recognize:
        requires:
          names-this-log:
            rule: "It names the log the trust root identifies, so an anchor of one log never witnesses another."
            expr: "self.log == trust_root.log"
          witnessed:
            rule: "It does not meet the encoding, its key is no credential of a witness named by the trust root in force at its position, or by the latest trust root read where that position was not read; a compromise revocation covers the key there; it was not read from where anchors are kept; it does not name its witness's last recognized anchor as previous, or lies before that anchor in position or observed time; the log extends it and not that previous anchor; or another anchor of its witness, which no compromise revocation covers either, names the same previous, or a pair of such anchors did earlier in the chain of previous anchors that leads to it."
            interpreter: verify.anchors
